<form class="borderlands-geography-roller">
    <p class="borderlands-geography-roller__status">
        {{localize "BORDERLANDS.RunningBonus"}}: {{runningBonus}}
        {{#if full}} — {{localize "BORDERLANDS.GeographyMapFull"}}{{/if}}
        {{#if stopped}} — {{localize "BORDERLANDS.GeographyStopped"}}{{/if}}
    </p>

    <ol class="borderlands-geography-roller__log">
        {{#each log}}
        <li>
            {{#if (eq this.type "river")}}
                {{localize "BORDERLANDS.GeographyLogRiver"}} ({{this.total}})
            {{else if (eq this.type "terrain")}}
                {{#if this.vegetation}}{{this.vegetation}} {{/if}}{{this.terrain}}
                — {{this.cells.length}} {{localize "BORDERLANDS.GeographySquares"}} ({{this.total}})
            {{else}}
                {{localize "BORDERLANDS.GeographyLogSpecial"}}: {{this.feature}}
                — {{this.cells.length}} {{localize "BORDERLANDS.GeographySquares"}} ({{this.total}})
            {{/if}}
        </li>
        {{/each}}
    </ol>

    <div class="borderlands-geography-roller__actions">
        <button type="button" data-action="rollNext" {{#if full}}disabled{{/if}} {{#if stopped}}disabled{{/if}}>
            {{localize "BORDERLANDS.RollNext"}}
        </button>
        <button type="button" data-action="endPhase">
            {{localize "BORDERLANDS.EndPhase"}}
        </button>
    </div>
</form>
